{
  "name": "atlas-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/sanity-plugin-atlas watch & bun run --cwd apps/studio dev",
    "build": "bun run --cwd packages/sanity-plugin-atlas build",
    "typecheck": "bun run --cwd packages/sanity-plugin-atlas typecheck",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "vitest": "^4.0.18"
  }
}
