{
  "name": "atlas-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/sanity-plugin-atlas watch & bun run --cwd apps/studio dev",
    "build": "bun run --cwd packages/sanity-plugin-atlas build",
    "typecheck": "bun run --cwd packages/sanity-plugin-atlas typecheck",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "semantic-release": "^25.0.3",
    "vitest": "^4.0.18"
  }
}
